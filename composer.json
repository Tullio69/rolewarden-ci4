{
    "name": "rolewarden/codeigniter4-rolewarden",
    "description": "Database-driven roles and permissions with an admin panel for CodeIgniter 4, built on Shield",
    "type": "library",
    "version": "1.1.0",
    "license": "proprietary",
    "keywords": [
        "codeigniter",
        "codeigniter4",
        "shield",
        "authorization",
        "rbac",
        "permissions",
        "roles",
        "admin panel"
    ],
    "homepage": "https://rolewarden.com",
    "require": {
        "php": "^8.3",
        "codeigniter4/framework": "^4.7.4",
        "codeigniter4/shield": "^1.4"
    },
    "suggest": {
        "codeigniter4/translations": "CodeIgniter's own messages (validation, relative dates) in the panel's other languages"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.64",
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "RoleWarden\\": "src/"
        },
        "exclude-from-classmap": [
            "**/Database/Migrations/**"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "RoleWarden\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse",
        "style": "php-cs-fixer fix --verbose --ansi"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "phpstan/extension-installer": true
        }
    }
}
